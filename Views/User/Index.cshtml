@model List<PinMapper.Web.ViewModel.UserViewModel>



<link rel="stylesheet" href="~/css/user-management.css" asp-append-version="true" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">



<div class="user-management">
    <div class="user-management-container">
        <div class="toast-container position-fixed bottom-0 start-50 translate-middle-x p-3">
            <div id="saveToast" class="toast custom-toast align-items-center text-white border-0" role="alert"
                 aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="ri-checkbox-circle-fill"></i>
                        User Details Updated Successfully
                    </div>
                    <button type="button" class=" toast-close btn-close me-2 m-auto" data-bs-dismiss="toast"
                            aria-label="Close"></button>
                </div>
            </div>
        </div>
        <header>
            <h2 class="dashboard_title">User Management</h2>
            <div class="header-right">
                <img src="~/images/bell with badge.png" alt="notification" class="notification_image">
                <div class="user-info">
                    <img src="~/images/Ellipse 269.png" alt="user">
                    <div class="user-details">
                        <span class="username">Ranjan PM</span>
                        <small class="user-designation">Super Admin</small>
                    </div>
                    <!-- Dropdown Menu -->
                    <div class="dropdown">
                        <button class="dropdown_toggle" onclick="toggleDropdown()">
                            <i class="ri-arrow-drop-down-line"></i>
                        </button>
                        <ul class="dropdown-menu">
                            <li><a href="#">Profile</a></li>
                            <li><a href="#">Help & Settings</a></li>
                            <li><a href="#">Logout</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </header>

        <div class="search-container">
            <button id="editBtn" data-bs-toggle="offcanvas" data-bs-target="#addUserSidebar">
                <i class="ri-add-circle-line"></i>Add
            </button>
        </div>
        <!-- Sidebar Offcanvas -->
        <div class="offcanvas offcanvas-end" tabindex="-1" id="addUserSidebar" aria-labelledby="addUserSidebarLabel">
            <div class="offcanvas-header p-4">
                <div class="d-flex flex-column gap-2">
                    <img src="~/images/Featured icon.png" class="rounded-circle me-2 sidebar_img" alt="User Icon">
                    <h5 class="offcanvas-title" id="addUserSidebarLabel">Add User</h5>
                    <p class="m-0">Enter below details to add User</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body">

                <form class="d-flex flex-column form-class" id="addUser" asp-action="CreateUser" method="post">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" name="Name" class="form-control" placeholder="Enter Name">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email ID</label>
                        <input type="email" name="Email" class="form-control" placeholder="Enter Email">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Contact</label>
                        <input type="contact" name="Contact" class="form-control" placeholder="Enter Contact Number">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Sector</label>
                        <select id="sectorDropdown" class="form-select" name="SectorId">
                            <option value="">Select Sector</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Sub Sector</label>
                        <select id="subSectorDropdown" class="form-select">
                            <option value="">Select Sub Sector</option>
                        </select>
                        <div class="tags-container" id="selectedTags"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Role</label>
                        <select id="roleDropdown" class="form-select" name="RoleId">
                            <option value="">Select Role</option>
                        </select>
                    </div>
                </form>


            </div>
            <div class="d-flex justify-content-end p-4 user-buttons">
                <button type="button" class="btn btn-outline-dark me-2 cancel-button"
                        data-bs-dismiss="offcanvas">
                    Cancel
                </button>
                <button type="submit" class="btn btn-warning  add-button" form="addUser">Save</button>
            </div>
        </div>
        <div id="myGrid" class="ag-theme-alpine"></div>
        @section Scripts
        {
            <script src="https://cdn.jsdelivr.net/npm/ag-grid-community@30.0.0/dist/ag-grid-community.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
            <script>
                            const subSectorSelect = document.getElementById('subSectorDropdown');
                const selectedTagsContainer = document.getElementById('selectedTags');
                const selectedSubSectors = new Set();

                subSectorSelect.addEventListener('change', function () {
                    const selectedOption = this.options[this.selectedIndex];
                    const value = selectedOption.value;          // ID
                    const name = selectedOption.textContent;     // Name to show

                    console.log("Selected ID:", value);
                    console.log("Selected Name:", name);

                                    if (value && !selectedSubSectors.has(value)) {
                    selectedSubSectors.add(value);

                    const tag = document.createElement('div');
                    tag.classList.add('tag');
                    tag.innerHTML = `
                        ${name}
                        <span class="remove-tag" data-value="${value}">&times;</span>
                    `;
                    selectedTagsContainer.appendChild(tag);

                    // Add hidden input field
                    const hiddenInput = document.createElement("input");
                    hiddenInput.type = "hidden";
                    hiddenInput.name = "SubSectorIds";
                    hiddenInput.value = value;
                    hiddenInput.dataset.tagValue = value;
                    document.getElementById("addUser").appendChild(hiddenInput);

                    selectedOption.style.display = "none";
                }

                    this.value = "";
                    this.blur(); // Reset selection
                });

                selectedTagsContainer.addEventListener('click', function (e) {

                   if (e.target.classList.contains('remove-tag')) {
                    const value = e.target.getAttribute('data-value');
                    selectedSubSectors.delete(value);
                    e.target.parentElement.remove();

                    // Remove corresponding hidden input
                    const hiddenInput = document.querySelector(`input[name="SubSectorIds"][data-tag-value="${value}"]`);
                    if (hiddenInput) {
                        hiddenInput.remove();
                    }

                    // Show the option again in dropdown
                    const optionToShow = Array.from(subSectorSelect.options).find(opt => opt.value === value);
                    if (optionToShow) {
                        optionToShow.style.display = "block";
                    }
                }
                });
                                
                                </script>


