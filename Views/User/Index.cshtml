                     });
                 };





                     function validateEmail(email) {
                         const emailRegex = /^[^\s@@]+@@[^\=s@@]+\.[^\s@@]+$/;
                         return emailRegex.test(email);
                     }

                     const dropzone = document.getElementById("dropzone");
                     const fileInput = document.getElementById("fileInput");
                     const uploadedImage = document.getElementById("uploadedImage");

                     dropzone.addEventListener("click", () => {
                         fileInput.value = "";
                         fileInput.click();
                     });
                     fileInput.addEventListener("change", (event) => {
                         if (event.target.files.length > 0) {
                             handleFileUpload(event.target.files[0]);
                         }
                     });
                     dropzone.addEventListener("dragover", (event) => {
                         event.preventDefault();
                         dropzone.classList.add("border-primary");
                     });

                     dropzone.addEventListener("dragleave", () => {
                         dropzone.classList.remove("border-primary");
                     });

                     dropzone.addEventListener("drop", (event) => {
                         event.preventDefault();
                         dropzone.classList.remove("border-primary");

                         if (event.dataTransfer.files.length > 0) {
                             handleFileUpload(event.dataTransfer.files[0]);
                         }
                     });



                     function handleFileUpload(file) {
                         if (file && (file.type === "image/png" || file.type === "image/jpeg")) {
                             const reader = new FileReader();
                             reader.onload = function (e) {
                                 uploadedImage.src = e.target.result;
                             };
                             reader.readAsDataURL(file);

                             fileInput.value = "";
                         } else {
                             alert("Only PNG and JPG images are allowed!");
                         }
                     }




                    function initializeGrid()
                    {
                              console.log("came here")


                     var columnDefs =
                    [

                        {
                         headerName: "Sector",
                         field: "sector",
                         width: 180,
                         editable: (params) => params.data.isEditing,
                         cellEditor: "agSelectCellEditor",
                         cellEditorParams: {
                             values: sectors.map((sector) => sector.name) || [],
                         },
                         sortable: true,
                         filter: true,
                         resizable: true,
                         cellStyle: {
                             display: "flex",
                             alignItems: "center",
                             fontSize: "14px",
                             fontWeight: 500,
                             color: "#74828F",
                         },
                         valueSetter: function (params) {
                             const oldValue = params.data.sector;
                             const newValue = params.newValue;

                             console.log("Sector Old Value:", oldValue, "Sector New Value:", newValue);

                             if (oldValue !== newValue) {
                                 params.data.sector = newValue;
                                 params.data.subSector = null; // Reset Subsector when Sector changes

                                 // Immediately update the grid with the new sector and reset subsector
                                 params.api.refreshCells({
                                     rowNodes: [params.node],
                                     force: true,
                                     columns: ["sector", "subSector"], // Refresh both sector and subsector columns
                                 });
                             }
                             return true;
                         },
                     },


                                                    {
                    headerName: "Sub Sectors",
                    field: "subSector",
                    width: 250,
                    sortable: true,
                    filter: true,
                    resizable: true,
                    autoHeight:true,
                    editable: false,
                  cellRenderer: function (params) {
                                if (!params.data.subSector) return "";
                                return params.data.subSector
                                    .map(subSector => `<div>${subSector.name || ""}</div>`)
                                    .join('');
                            },
                    cellStyle: {
                        display: "flex",
                        flexDirection: "column",
                        fontSize: "14px",
                        fontWeight: 500,
                        color: "#74828F"
                    }
                },
                                  {
                                      headerName: "Name",
                                      field: "name",
                                      width: 250,
                                      sortable: true,
                                      editable: (params) => params.data.isEditing,
                                      filter: true,
                                      resizable: true,
                                      cellStyle: {
                                          display: "flex",
                                          alignItems: "center",
                                          fontSize: "14px",
                                          fontWeight: 500,
                                          color: "#74828F"
                                      },
                                      valueSetter: function (params) {
                                          params.data.name = params.newValue;
                                          const nameRegex = /^[a-zA-Z0-9 ]{1,30}$/;
                                          if (!newValue) {
                                              params.data.invalidName = true;
                                              params.data.nameErrorMessage = "Name cannot be empty";
                                          } else if (!nameRegex.test(newValue)) {
                                              params.data.invalidName = true;
                                              params.data.nameErrorMessage = "Only alphanumeric characters allowed (max 30 characters).";
                                          }
                                          return true;
                                      },
                                      valueSetter: function (params) {
                                          const newValue = params.newValue?.trim() || "";
                                          let errorMessage = "";

                                          // Set error message if any
                                          params.data.nameError = errorMessage;

                                          // Only update value if valid
                                          if (!errorMessage) {
                                              params.data.name = newValue;
                                              return true;
                                          }

                                          return false;
                                      },
                                      cellRenderer: function (params) {
                                          const container = document.createElement("div");
                                          container.style.display = "flex";
                                          container.style.alignItems = "center";
                                          container.style.gap = "6px";

                                          const nameText = document.createElement("span");
                                          nameText.innerText = params.value || "";
                                          container.appendChild(nameText);

                                          if (params.data?.nameError) {
                                              const errorIcon = document.createElement("i");
                                              errorIcon.className = "ri-error-warning-line";
                                              errorIcon.style.color = "red";
                                              errorIcon.style.cursor = "pointer";
                                              errorIcon.title = errorMessage;
                                              container.appendChild(errorIcon);
                                          }

                                          return container;
                                      }
                                  }
                                  ,
                                  {
                                      headerName: "Email",
                                      field: "email",
                                      editable: (params) => params.data.isEditing,
                                      cellEditor: "agTextCellEditor",

                                      valueSetter: function (params) {
                                          params.data.email = params.newValue;
                                          if (!validateEmail(params.newValue)) {
                                              params.data.invalidEmail = true;
                                              params.data.emailErrorMessage = "Invalid Email Format!";
                                          } else {
                                              params.data.invalidEmail = false;
                                              params.data.emailErrorMessage = "";
                                          }
                                          return true;
                                      },
                                      cellClassRules: {
                                          'email-error-cell': (params) => params.data?.invalidEmail === true
                                      },
                                      cellRenderer: function (params) {
                                          console.log("Is Editing (inside cellRenderer):", params.data?.isEditing);

                                          const container = document.createElement("div");
                                          container.style.display = "flex";
                                          container.style.alignItems = "center";
                                          container.style.gap = "8px";


                                          const emailText = document.createElement("span");
                                          emailText.innerText = params.value || "";
                                          container.appendChild(emailText);
                                          if (params.data?.invalidEmail) {
                                              const errorIcon = document.createElement("i");
                                              errorIcon.className = "ri-error-warning-line";
                                              errorIcon.style.color = "red";
                                              errorIcon.style.cursor = "pointer";
                                              errorIcon.title = params.data.emailErrorMessage;
                                              container.appendChild(errorIcon);
                                          }

                                          return container;
                                      }
                                  },
                                  {
                                      headerName: "Contact",
                                      field: "contact",
                                      editable: (params) => params.data.isEditing,
                                      cellEditor: "agTextCellEditor",
                                      valueSetter: function (params) {
                                          params.data.contact = params.newValue;
                                          return true;
                                      },
                                      cellRenderer: function (params) {
                                          const container = document.createElement("div");
                                          container.style.display = "flex";
                                          container.style.alignItems = "center";
                                          const nameText = document.createElement("span");
                                          nameText.innerText = params.value || "";
                                          container.appendChild(nameText);
                                          return container;
                                      }
                                  }
                                  ,

                                  {
