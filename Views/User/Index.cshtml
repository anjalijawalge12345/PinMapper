                function loadSectors()
                {
                         fetch('/User/GetSector')
                             .then(response => response.json())
                             .then(data => {
                                     console.log("before Sectors Loaded:");
                                    sectors = data || [];
                                    initializeGrid();
                                 let sectorDropdown = document.getElementById("sectorDropdown");
                                     sectorDropdown.innerHTML = '<option value="">Select Sector</option>';

                                     sectors.forEach(sector => {
                                         sectorDropdown.innerHTML += `<option value="${sector.id}">${sector.name}</option>`;
                                     });
                             })
                                 .catch(error => console.error("Error loading sectors:", error));
                }
                     function getSubSectorNames(sectorName) {
                         if (!sectorName) return [];
                         const selectedSector = sectors.find((sector) => sector.name === sectorName);
                         if (!selectedSector) return [];
                         const subSectors = allSubSectors.filter((subSector) => subSector.sectorId === selectedSector.id);
                         return subSectors.map((subSector) => subSector.name);
                     }

                     function loadRoles() {
                         fetch('/User/GetRoles')
                             .then(response => response.json())
                             .then(data => {
                                 roles = data || []; // Store role data
                                 console.log("Roles Loaded:", roles);

                                 let roleDropdown = document.getElementById("roleDropdown");
                                 roleDropdown.innerHTML = '<option value="">Select Role</option>';

                                 roles.forEach(role => {
                                     roleDropdown.innerHTML += `<option value="${role.id}">${role.name}</option>`;
                                 });
                             })
                             .catch(error => console.error("Error loading roles:", error));
                     }

                     function getRoleNames() {
                         return roles.map((role) => role.name);
                     }
                     function loadSubSectors(sectorId) {
                         fetch(`/User/GetSubSectors?sectorId=${sectorId}`)
                             .then(response => response.json())
                              .then(data => {
                                     console.log(`Sub-Sectors for ${sectorId}:`, data);

                                     // Extract actual sub-sector values
                                     let subSectors = data || [];

                                     let subSectorDropdown = document.getElementById("subSectorDropdown");
                                     subSectorDropdown.innerHTML = '<option value="">Select Sub Sector</option>';

                                     subSectors.forEach(subSector => {
                                         subSectorDropdown.innerHTML += `<option value="${subSector.id}">${subSector.name}</option>`;
                                     });
                                 })
                             .then(data => {
                                 allSubSectors = allSubSectors.filter(sub => sub.sectorId !== Number(sectorId)).concat(data); //Store all subsectors
                                 console.log(`Sub-Sectors for ${sectorId}:`, data);
                                 // ... (rest of the loadSubSectors function)
                             })
                             .catch(error => console.error("Error loading sub-sectors:", error));
                     }

                     function clearSubSectors() {
                         let subSectorDropdown = document.getElementById("subSectorDropdown");
                         subSectorDropdown.innerHTML = '<option value="">Select Sub Sector</option>';
                     }

                     function loadSectorSubsector() {
                         fetch('/User/GetSectorsWithSubSectors') // API endpoint to get sectors
                             .then(response => response.json())
                             .then(data => {
                                 console.log("loadSectorSubsector:", data);
                             })
                             .catch(error => console.error("Error loadSectorSubsector:", error));
                     }


                     document.querySelector(".add-button").addEventListener("click", async function ()
                     {
                         let userData = {
                             Name: document.querySelector("input[placeholder='Enter Name']").value.trim(),
                             Email: document.querySelector("input[placeholder='Enter Email']").value.trim(),
                             Contact: document.querySelector("input[placeholder='Enter Contact Number']").value.trim() || null, // Set to null if empty
                             SectorId: document.getElementById("sectorDropdown").value,
                             SubSectorId: document.getElementById("subSectorDropdown").value,
                             RoleId: document.querySelector("roleDropDown").value
                         };

                         // Validate required fields
                         if (!userData.Name || !userData.Email || !userData.SectorId || !userData.SubSectorId || !userData.Role) {
                             alert("Name, Email, Sector, Sub Sector, and Role are required fields.");
                             return;
                         }

                         try {
                             let response = await fetch("/User/CreateUser", {
                                 method: "POST",
                                 headers: { "Content-Type": "application/json" },
                                 body: JSON.stringify(userData)
                             });

                             let result = await response.json();

                             if (response.ok) {
                                 alert(result.message);
                                 location.reload(); // Refresh or update UI
                             } else {
                                 alert("Error: " + result.message);
                             }
                         } catch (error) {
                             console.error("Error:", error);
                             alert("Something went wrong!");
                         }
                     });






            </script>
        }

    </div>
</div>