                     }
                      debugger;
                                     fetch("/User/CreateUser", {  // Adjust API URL if needed
                         method: "POST",
                         headers: {
                             "Content-Type": "application/json"
                         },
                         body: JSON.stringify(userData)
                     })
                     .then(response => {
                         if (!response.ok) {
