        { title: "GJ.PB", date: "Jun 20, 2019", creator: "Dhananjay Patil" },
        { title: "GA.PN", date: "Jun 20, 2019", creator: "Dhananjay Patil" },
        { title: "MP.JB", date: "Jun 20, 2019", creator: "Dhananjay Patil" },
    ];

    const filterButtons = document.querySelectorAll(".filter-buttons button");
    const cardContainer = document.querySelector(".card-container");
    const searchContainer = document.querySelector(".search-container");
    const myGrid = document.querySelector("#myGrid");
const paginationContainer = document.getElementById("pagination-container");

    const prevBtn = document.getElementById("prevPage");
    const nextBtn = document.getElementById("nextPage");
    const pageNumberDisplay = document.getElementById("pageNumber");
     let currentPage = 1;
    const cardsPerPage = 8;
    filterButtons.forEach((button, index) => {
        button.addEventListener("click", function () {
            document.querySelector(".filter-buttons .active")?.classList.remove("active");
            this.classList.add("active");

            if (index === 2 || index === 3) {
                searchContainer.style.display = "none";
            } else {
                searchContainer.style.display = "flex";
            }

            if (index === 2) {
                myGrid.style.display = "none";
                cardContainer.style.display = "flex";
                paginationContainer.style.display = "none";
                renderCards(sampleData);
            } else if (index === 3) {
                myGrid.style.display = "none";
                cardContainer.style.display = "flex";
                paginationContainer.style.display = "flex";
                currentPage = 1;
                renderPaginatedCards(districtCodeData, currentPage);
            } else {
                myGrid.style.display = "block";
                cardContainer.style.display = "none";
                paginationContainer.style.display = "none";
            }
        });
    });

    function renderCards(data) {
        cardContainer.innerHTML = data
            .map(item => createCardHTML(item))
            .join("");
    }

    function renderPaginatedCards(data, page) {
        const startIndex = (page - 1) * cardsPerPage;
        const endIndex = startIndex + cardsPerPage;
        const paginatedData = data.slice(startIndex, endIndex);
        cardContainer.innerHTML = paginatedData
            .map(item => createCardHTML(item))
            .join("");

        const totalPages = Math.ceil(data.length / cardsPerPage);
    pageNumber.textContent = `Page ${currentPage} of ${totalPages}`;
      const entryCount = document.getElementById("entryCount");
    entryCount.textContent = `Showing ${paginatedData.length} data of ${data.length} entries`;
        prevBtn.disabled = page === 1;
        nextBtn.disabled = endIndex >= data.length;
    }

    function createCardHTML(item) {
        return `
            <div class="card">
                <div class="title">${item.title}</div>
                <div class="img-details">
                    <img src="/images/Frame 1261153459.png" class="calendar-image" />
                    <div class="details">
                        <span class="creation-text"> Creation Date</span> 
                        <span class="creation-date">${item.date}</span>
                    </div>
                </div>
                <div class="img-details">
                    <img src="/images/Frame 1261153459 (1).png" class="calendar-image" />
                    <div class="details">
                        <span class="creation-text"> Created By</span> 
                        <span>${item.creator}</span>
                    </div>
                </div>
            </div>`;
    }

    prevBtn.addEventListener("click", () => {
        if (currentPage > 1) {
            currentPage--;
            renderPaginatedCards(districtCodeData, currentPage);
        }
    });

    nextBtn.addEventListener("click", () => {
        if ((currentPage * cardsPerPage) < districtCodeData.length) {
            currentPage++;
            renderPaginatedCards(districtCodeData, currentPage);
        }
    });
</script>
