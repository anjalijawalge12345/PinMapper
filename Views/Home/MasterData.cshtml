<link rel="stylesheet" href="~/css/master-data.css" asp-append-version="true" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<!-- AG Grid Styles (v31+) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ag-grid-community@31.2.1/styles/ag-grid.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ag-grid-community@31.2.1/styles/ag-theme-quartz.css" />

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon/fonts/remixicon.css">
<div class="master-data">
    <div class="master-data-container">
        <header>
            <h2 class="dashboard_title">Master Data</h2>
            <div class="header-right">
                <img src="~/images/bell with badge.png" alt="notification" class="notification_image">
                <div class="user-info">
                    <img src="~/images/Ellipse 269.png" alt="user">
                    <div class="user-details">
                        <span class="username">Ranjan PM</span>
                        <small class="user-designation">Super Admin</small>
                    </div>
                    <div class="dropdown">
                        <button class="dropdown_toggle" onclick="toggleDropdown()"><i
                                class="ri-arrow-drop-down-line"></i></button>
                        <ul class="dropdown-menu">
                            <li><a href="#">Profile</a></li>
                            <li><a href="#">Help & Settings</a></li>
                            <li><a href="#">Logout</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </header>

        <div class="filter-buttons">
            <button class="active">Workflow Definition</button>
            <button class="new-tab">Zone - Sub Zone - RO</button>
            <button>Function</button>
            <button>District Code</button>
        </div>
        <div class="search-container">
            <button id="editBtn" data-bs-toggle="offcanvas" data-bs-target="#addUserSidebar"><i
                    class="ri-add-circle-line"></i>Add</button>
        </div>
        <div id="zone_subZone_RO_container">
            <div class="d-flex align-items-center gap-4">
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="level" id="zone" checked>
                    <label class="form-check-label" for="zone">Zone <span class="count">(05)</span></label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="level" id="subZone">
                    <label class="form-check-label" for="subZone">Sub-Zone <span class="count">(12)</span></label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="level" id="regionalOffice">
                    <label class="form-check-label" for="regionalOffice">Regional Office <span
                            class="count">(300)</span></label>
                </div>
                <button id="editBtn1" class="ms-auto add-btn d-flex align-items-center">
                    <i class="ri-add-circle-line me-1"></i> Add <span id="addLabel">Zone</span>
                </button>

            </div>
        </div>
        <div id="zoneContainer" style="display: none;">
            @{
                await Html.RenderPartialAsync("_Zone");
            }
        </div>

        <div id="subZoneContainer" style="display: none;">
            @{
                await Html.RenderPartialAsync("_SubZone");
            }
        </div>
        <div id="ROContainer" style="display: none;">
            @{
                await Html.RenderPartialAsync("_RegionalOffice");
            }
        </div>
        <div class="offcanvas offcanvas-end" tabindex="-1" id="addUserSidebar" aria-labelledby="addUserSidebarLabel">
            <div class="offcanvas-header p-4">
                <div class="d-flex flex-column gap-2 ">
                    <img src="~/images/Featured icon.png" class="rounded-circle me-2 sidebar_img" alt="User Icon">
                    <h5 class="offcanvas-title" id="addUserSidebarLabel">Add Workflow Definition</h5>
                    <p class="m-0 offcanvas-subtitle">Enter below details to add new Workflow Definition</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body">

                <form class="d-flex gap-4 form-class">
                    <div class="mb-3">
                        <label class="form-label">Function</label>
                        <select class="form-select select-option" id="functionSelect">
                            <option>Select Function</option>
                            <option>Industrial</option>
                            <option>Retail</option>
                            <option>CSS</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Workflow Name</label>
                        <input type="text" class="form-control" placeholder="Enter Name" id="workflowInput">
                    </div>




                </form>
                <div class="approval-level-container">
                    <div class="approval-level-heading-container d-flex align-items-center gap-2">
                        <div>Approval Level</div>
                        <i class="ri-information-fill custom-tooltip" id="infoIcon" data-bs-toggle="tooltip"
                            data-bs-placement="right" title="You can add minimum of 1 and maximum of 10 levels."></i>
                        <span id="maxLimitMessage" style="display: none;">You have
                            reached max limit</span>
                    </div>
                    <button class="add-level-button" id="addApprovalBtn">Add</button>
                </div>

                <div id="approvalFieldsContainer"></div>


            </div>
            <div class="d-flex justify-content-end p-4 user-buttons">
                <button type="button" class="btn btn-outline-dark me-2 cancel-button"
                    data-bs-dismiss="offcanvas">Cancel</button>
                <button type="button" class="btn btn-warning  add-button" onclick="showToast()">Save</button>
            </div>
        </div>
        <div id="myGrid" class="ag-theme-quartz"></div>
        <div id="functionGrid" class="ag-theme-quartz"></div>
        <div id="disrictCodeGrid" class="ag-theme-quartz"></div>

        <div class="card-container" style="display: none;">
        </div>
        <div id="pagination-container"
            style="display:none; margin-top: 10px; text-align:center; align-items: center;gap:0.5rem; justify-content: space-between;">
            <span id="entryCount" style="margin-left: 15px;"></span>
            <div>
                <button id="prevPage"><i class="ri-arrow-left-s-line"></i></button>
                <span id="pageNumber">Page 1</span>
                <button id="nextPage"><i class="ri-arrow-right-s-line"></i></button>
            </div>
        </div>
    </div>
</div>
