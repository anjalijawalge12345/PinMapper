    <script>




        const filterButtons = document.querySelectorAll(".filter-buttons button");
        const searchContainer = document.querySelector(".search-container");
        const myGrid = document.querySelector("#myGrid");
        const functionGrid = document.querySelector("#functionGrid");
        const disrictCodeGrid = document.querySelector("#disrictCodeGrid");
        const zone_subZone_RO_container = document.querySelector("#zone_subZone_RO_container");
        const zoneContainer = document.querySelector("#zoneContainer");
        const subZoneContainer = document.querySelector("#subZoneContainer");
        const ROContainer = document.querySelector("#ROContainer");
        const radios = document.querySelectorAll('input[name="level"]');
        const editBtn1 = document.getElementById("editBtn1");
        const addLabel = document.getElementById("addLabel");

        function updateContainerDisplay() {
            zoneContainer.style.display = "none";
            subZoneContainer.style.display = "none";
            ROContainer.style.display = "none";
            if (document.getElementById("zone").checked) {
                zoneContainer.style.display = "block";
                addLabel.textContent = "Zone";
                editBtn1.setAttribute("data-bs-toggle", "offcanvas");
                editBtn1.setAttribute("data-bs-target", "#addUserSidebar1");
            } else if (document.getElementById("subZone").checked) {
                subZoneContainer.style.display = "block";
                addLabel.textContent = "Sub-Zone";
                editBtn1.setAttribute("data-bs-toggle", "offcanvas");
                editBtn1.setAttribute("data-bs-target", "#addUserSidebar2");
            } else if (document.getElementById("regionalOffice").checked) {
                ROContainer.style.display = "block";
                addLabel.textContent = "RO";
                editBtn1.setAttribute("data-bs-toggle", "offcanvas");
                editBtn1.setAttribute("data-bs-target", "#addUserSidebar3");
            }
            editBtn1.setAttribute("data-bs-toggle", "offcanvas");
        }
        radios.forEach(radio => {
            radio.addEventListener("change", updateContainerDisplay);
        });
        updateContainerDisplay();

        myGrid.style.display = "block";
        functionGrid.style.display = "none";
        searchContainer.style.display = "flex";
        disrictCodeGrid.style.display = "none";
        zone_subZone_RO_container.style.display = "none";
        zoneContainer.style.display = "none";
        subZoneContainer.style.display = "none";
        ROContainer.style.display = "none";
        filterButtons.forEach((button, index) => {
            button.addEventListener("click", function () {
                document.querySelector(".filter-buttons .active")?.classList.remove("active");
                this.classList.add("active");
                const hideSearchFor = [1, 2, 3];
                searchContainer.style.display = hideSearchFor.includes(index) ? "none" : "flex";
                myGrid.style.display = "none";
                functionGrid.style.display = "none";
                disrictCodeGrid.style.display = "none";
                zone_subZone_RO_container.style.display = "none";
                zoneContainer.style.display = "none";
                subZoneContainer.style.display = "none";
                ROContainer.style.display = "none";

                // Show specific grid based on index
                switch (index) {
                    case 2:
                        functionGrid.style.display = "block";
                        break;
                    case 3:
                        disrictCodeGrid.style.display = "block";
                        break;
                    case 1:
                        zone_subZone_RO_container.style.display = "block";
                        zoneContainer.style.display = "block";
                        break;
                    default:
                        myGrid.style.display = "block";
                        break;
                }

                console.log(index);
            });
        });




        const addBtn = document.getElementById("addApprovalBtn");
        const container = document.getElementById("approvalFieldsContainer");
        const functionSelect = document.getElementById("functionSelect");
        const workflowInput = document.getElementById("workflowInput");
        const infoIcon = document.getElementById("infoIcon");
        const maxLimitMessage = document.getElementById("maxLimitMessage");

        const allUsers = ["Amey Patwardhan", "Ashish Solanki", "Swapnil Patil"];
        let levelCount = 0;

        function checkFormFields() {
            const functionSelected = functionSelect.value !== '';
            const workflowEntered = workflowInput.value.trim() !== '';
            const canAddMoreLevels = levelCount <= 10;

            addBtn.disabled = !(functionSelected && workflowEntered && canAddMoreLevels);
            console.log("common", levelCount)

        }

        function getAllSelectedUsers() {
            const selectedValues = [];
            const selects = container.querySelectorAll("select");
            selects.forEach(select => {
                const value = select.value;
                if (value && value !== "Select User") {
                    selectedValues.push(value);
                }
            });
            return selectedValues;
        }

        function updateAllDropdownOptions() {
            const selectedUsers = getAllSelectedUsers();

            const allSelects = container.querySelectorAll("select");
            allSelects.forEach(select => {
                const currentValue = select.value;
                select.innerHTML = `<option>Select User</option>`;
                allUsers.forEach(user => {
                    if (!selectedUsers.includes(user) || user === currentValue) {
                        const option = document.createElement("option");
                        option.value = user;
                        option.textContent = user;
                        select.appendChild(option);
                    }
                });

                if ([...select.options].some(opt => opt.value === currentValue)) {
                    select.value = currentValue;
                } else {
                    select.value = "Select User";
                }
            });
        }
        checkFormFields();
        function addApprovalLevel() {
            if (levelCount >= 9) {
                infoIcon.style.color = "#ED6A5A";
                maxLimitMessage.style.display = "inline";
                maxLimitMessage.style.fontStyle = "italic";
                maxLimitMessage.style.fontSize = "12px";
                maxLimitMessage.style.fontWeight = "400";
                maxLimitMessage.style.color = "#ED6A5A";
            } else {
                infoIcon.style.color = "";
                maxLimitMessage.style.display = "none";
            }
            if (levelCount >= 10) return;

            const fieldGroup = document.createElement("div");
            fieldGroup.classList.add("mb-3");

            const label = document.createElement("label");
            label.classList.add("form-label");
            label.textContent = `Level ${levelCount + 1} User`;

            const selectRow = document.createElement("div");
            selectRow.classList.add("d-flex", "align-items-center", "justify-content-between");
            selectRow.style.gap = "10px";

            const select = document.createElement("select");
            select.classList.add("form-select");
            select.style.width = "512px";

            const deleteBtn = document.createElement("i");
            deleteBtn.classList.add("ri-delete-bin-line", "delete-icon");
            deleteBtn.style.cursor = "pointer";
            deleteBtn.style.color = "red";
            deleteBtn.style.fontSize = "20px";
            deleteBtn.title = "Remove this level";

            select.addEventListener("change", updateAllDropdownOptions);

            deleteBtn.addEventListener("click", function () {
                fieldGroup.remove();
                levelCount--;
                console.log("delete", levelCount)
                reRenderLevelLabels();
                updateAllDropdownOptions();
                checkFormFields();
            });

            selectRow.appendChild(select);
            selectRow.appendChild(deleteBtn);
            fieldGroup.appendChild(label);
            fieldGroup.appendChild(selectRow);
            container.appendChild(fieldGroup);

            levelCount++;
            console.log(levelCount)
            if (levelCount >= 10) {
                addBtn.disabled = true;
            }
            updateAllDropdownOptions();

        }

        addBtn.addEventListener("click", addApprovalLevel);
        functionSelect.addEventListener('change', checkFormFields);
        workflowInput.addEventListener('input', checkFormFields);

        function reRenderLevelLabels() {
            const allGroups = container.querySelectorAll(".mb-3 > label");
            allGroups.forEach((labelEl, index) => {
                labelEl.textContent = `Level ${index + 1} User`;
            });
        }

    </script>
}
