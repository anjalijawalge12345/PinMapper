<link rel="stylesheet" href="~/css/master-data.css" asp-append-version="true" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ag-grid-community@31.2.1/styles/ag-grid.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ag-grid-community@31.2.1/styles/ag-theme-quartz.css" />
<div id="subZoneGrid" class="ag-theme-quartz">

    <div class="offcanvas offcanvas-end" tabindex="-1" id="addUserSidebar2" aria-labelledby="addUserSidebarLabel">
        <div class="offcanvas-header p-4">
            <div class="d-flex gap-2">
                <img src="~/images/zoneicon.png" class="rounded-circle me-2 sidebar_img" alt="User Icon">
                <div class="d-flex flex-column">
                    <h5 class="offcanvas-title" id="addUserSidebarLabel">Add Sub-Zone</h5>
                    <p class="m-0">Add multiple Sub-Zones</p>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <div class="mb-3">
                <label class="form-label">Zone</label>
                <select class="form-select">
                    <option>Select</option>
                    <option>East-EZ</option>
                    <option>West-WZ</option>
                    <option>Central-CZ</option>
                </select>
            </div>
            <div class="d-flex justify-content-between items-center">
                <div class="d-flex  gap-2 items-center">
                    <div class="zone-title">Sub-Zone</div>
                    <div id="subZoneErrorMessage" class="text-danger mb-3" style="display: none;"></div>
                </div>
                <button id="subZoneAddFieldButton" class="add-level-button">Add</button>
            </div>
            <form class="d-flex flex-column form-class" id="zoneForm">
                <div id="dynamicFieldsContainer1"></div>
            </form>


        </div>
        <div class="d-flex justify-content-end p-4 user-buttons">
            <button type="button" class="btn btn-outline-dark me-2 cancel-button"
                data-bs-dismiss="offcanvas">Cancel</button>
            <button type="button" class="btn btn-warning  add-button" onclick="showToast()">Save</button>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/ag-grid-community@31.2.1/dist/ag-grid-community.min.js"></script>
<script>
    window.addEventListener('DOMContentLoaded', function () {
        const columnDefs = [
            {
                headerName: "Zone Name", field: "zoneName", editable: true, filter: "agSetColumnFilter", // Ensure this is set for miniFilter support
                floatingFilter: true, cellEditor: "agTextCellEditor", sortable: true, filter: true, resizable: true, cellStyle: { display: "flex", alignItems: "center", fontSize: "14px", fontWeight: 500, color: "#74828F" }
            },
            {
                headerName: "Zone Code", field: "zoneCode", editable: true, filter: "agSetColumnFilter", // Ensure this is set for miniFilter support
                floatingFilter: true, sortable: true, cellEditor: "agTextCellEditor", filter: true, resizable: true, cellStyle: { display: "flex", alignItems: "center", fontSize: "14px", fontWeight: 500, color: "#74828F" }
            },
            {
                headerName: "Sub-Zone Name", field: "subZoneName", editable: true, filter: "agSetColumnFilter", // Ensure this is set for miniFilter support
                floatingFilter: true, sortable: true, cellEditor: "agTextCellEditor", filter: true, resizable: true, cellStyle: { display: "flex", alignItems: "center", fontSize: "14px", fontWeight: 500, color: "#74828F" }
            },
            {
                headerName: "Sub-Zone Code", field: "subZoneCode", editable: true, filter: "agSetColumnFilter", // Ensure this is set for miniFilter support
                floatingFilter: true, sortable: true, cellEditor: "agTextCellEditor", filter: true, resizable: true, cellStyle: { display: "flex", alignItems: "center", fontSize: "14px", fontWeight: 500, color: "#74828F" }
            },
            {
                headerName: "Action",
                field: "action",
                filter: true,
                resizable: true,
                sortable: false,
                cellStyle: {
                    display: "flex",
                    alignItems: "center",
                    fontSize: "14px",
                    fontWeight: 500,
                    color: "#74828F",
                    gap: "8px",
                },
                cellRenderer: function (params) {
                    const container = document.createElement("div");

                    if (params.data.isEditing) {
                        // ✅ Save Button
                        const saveBtn = document.createElement("button");
                        saveBtn.innerHTML = `<i class="ri-check-line"></i>`;
                        saveBtn.className = "save-btn";
                        saveBtn.onclick = () => {
                            params.data.isEditing = false;
                            params.api.stopEditing();
                            params.api.refreshCells({ force: true });
                        };
                        container.appendChild(saveBtn);


                        const cancelBtn = document.createElement("button");
                        cancelBtn.innerHTML = `<i class="ri-close-line"></i>`;
                        cancelBtn.className = "cancel-btn";
                        cancelBtn.onclick = () => {
                            console.log("Cancelling...");
                            params.data.isEditing = false;
                            params.api.stopEditing(true);

                            params.api.refreshCells({ force: true });
                        };
                        container.appendChild(cancelBtn);
                    } else {
                        const editBtn = document.createElement("button");
                        editBtn.innerHTML = `<i class="ri-pencil-line"></i> <span style="text-decoration: underline;">Edit</span>`;
                        editBtn.className = "edit-btn";
                        editBtn.onclick = () => {
                            params.data.isEditing = true;
                            params.api.refreshCells({ force: true });
                            params.api.startEditingCell({
                                rowIndex: params.rowIndex,
                                colKey: "zoneName"
                            });
                        };
                        container.appendChild(editBtn);
                    }

                    return container;
                }
            }

        ];

        const rowData = [
            { zoneName: "East", zoneCode: "EZ", subZoneName: "E", subZoneCode: "3" },
            { zoneName: "West", zoneCode: "WZ", subZoneName: "W", subZoneCode: "4" },
            { zoneName: "South", zoneCode: "SZ", subZoneName: "S", subZoneCode: "5" },
            { zoneName: "North", zoneCode: "NZ", subZoneName: "N", subZoneCode: "6" },
            { zoneName: "Central", zoneCode: "CZ", subZoneName: "C", subZoneCode: "7" },
            { zoneName: "West", zoneCode: "WZ", subZoneName: "W", subZoneCode: "4" },
            { zoneName: "South", zoneCode: "SZ", subZoneName: "S", subZoneCode: "5" },
            { zoneName: "Central", zoneCode: "CZ", subZoneName: "C", subZoneCode: "C" },
            { zoneName: "Central", zoneCode: "CZ", subZoneName: "C", subZoneCode: "C" },
            { zoneName: "Central", zoneCode: "CZ", subZoneName: "C", subZoneCode: "C" },

        ];

        const gridOptions = {
            columnDefs,
            rowData,
            pagination: true,
            paginationPageSize: 20,
            editType: "fullRow",
            rowHeight: 40,
            onGridReady: function (params) {
                params.api.sizeColumnsToFit();
            },
            domLayout: 'autoHeight',
        };
        var gridDiv = document.querySelector("#subZoneGrid");
        new agGrid.Grid(gridDiv, gridOptions);
        let fieldCount = 0;

        document.getElementById('subZoneAddFieldButton').addEventListener('click', () => {
            const errorDiv = document.getElementById('subZoneErrorMessage');
            const addButton = document.getElementById('subZoneAddFieldButton');
            if (fieldCount >= 10) {
                addButton.disabled = true;
                errorDiv.innerText = "You cannot add more than 10 zones.";
                errorDiv.style.display = "block";
                return;
            }

            // Clear error if previously shown
            errorDiv.innerText = "";
            errorDiv.style.display = "none";
            fieldCount++;

            const container = document.createElement('div');
            container.classList.add('field-group', 'mb-3');

            container.innerHTML = `
        <div class="d-flex align-items-end gap-2">
            <div class="flex-grow-1">
                <input type="text" class="form-control" name="subZoneName${fieldCount}" placeholder="Enter SubZone Name">
            </div>
            <div class="flex-grow-1">
                <input type="text" class="form-control" name="subZoneCode${fieldCount}" placeholder="Enter SubZone Code">
            </div>
           <i class="ri-delete-bin-line remove-btn"></i>
        </div>
    `;

            // Add to container
            document.getElementById('dynamicFieldsContainer1').appendChild(container);

            // Add remove functionality
            container.querySelector('.remove-btn').addEventListener('click', () => {
                container.remove();
            });
        });
    });
</script>