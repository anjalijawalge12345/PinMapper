    <div id="saveToast" class="toast custom-toast align-items-center text-white border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                <i class="ri-checkbox-circle-fill"></i>
                User Details Updated Successfully
            </div>
            <button type="button" class=" toast-close btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>
        <header>
            <h2 class="dashboard_title">User Management</h2>
            <div class="header-right">
                <img src="~/images/bell with badge.png" alt="notification" class="notification_image">
                <div class="user-info">
                    <img src="~/images/Ellipse 269.png" alt="user">
                    <div class="user-details">
                        <span class="username">Ranjan PM</span>
                        <small class="user-designation">Super Admin</small>
                    </div>
                    <!-- Dropdown Menu -->
                    <div class="dropdown">
                        <button class="dropdown_toggle" onclick="toggleDropdown()"><i class="ri-arrow-drop-down-line"></i></button>
                        <ul class="dropdown-menu">
                            <li><a href="#">Profile</a></li>
                            <li><a href="#">Help & Settings</a></li>
                            <li><a href="#">Logout</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </header>

       <div class="search-container">
        <button id="editBtn" data-bs-toggle="offcanvas" data-bs-target="#addUserSidebar"><i class="ri-add-circle-line"></i>Add</button>
    </div>
<!-- Sidebar Offcanvas -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="addUserSidebar" aria-labelledby="addUserSidebarLabel">
    <div class="offcanvas-header p-4">
        <div class="d-flex flex-column gap-2">
            <img src="~/images/Featured icon.png" class="rounded-circle me-2 sidebar_img" alt="User Icon">
            <h5 class="offcanvas-title" id="addUserSidebarLabel">Add User</h5>
             <p class="m-0">Enter below details to add User</p>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">

        <form class="d-flex flex-column form-class">
            <div class="mb-3">
                <label class="form-label">Name</label>
                <input type="text" class="form-control" placeholder="Enter Name">
            </div>
            <div class="mb-3">
                <label class="form-label">Email ID</label>
                <input type="email" class="form-control" placeholder="Enter Email">
            </div>
             <div class="mb-3">
                <label class="form-label">Contact</label>
                <input type="contact" class="form-control" placeholder="Enter Contact Number">
            </div>
               <div class="mb-3">
                <label class="form-label">Sector</label>
                <select class="form-select">
                    <option>Select Sector</option>
                    <option>SPB</option>
                    <option>IDCD</option>
                </select>
            </div>
               <div class="mb-3">
                <label class="form-label">Sub Sector</label>
                <select class="form-select">
                    <option>Select Sub Sector</option>
                    <option>Industry</option>
                    <option>Retail</option>
                    <option>CSS</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Role</label>
                <select class="form-select">
                    <option>Select Role</option>
                    <option>Admin</option>
                    <option>Checker</option>
                    <option>Maker</option>
                </select>
            </div>
        </form>

       
    </div>
     <div class="d-flex justify-content-end p-4 user-buttons">
            <button type="button" class="btn btn-outline-dark me-2 cancel-button" data-bs-dismiss="offcanvas">Cancel</button>
            <button type="button" class="btn btn-warning  add-button" onclick="showToast()">Save</button>
        </div>
