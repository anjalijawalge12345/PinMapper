<div class="user-management">
    <div class="user-management-container">
        <div class="toast-container position-fixed bottom-0 start-50 translate-middle-x p-3">
            <div id="saveToast" class="toast custom-toast align-items-center text-white border-0" role="alert"
                aria-live="assertive" aria-atomic="true" data-bs-delay="70000">
                <div class="d-flex align-items-center gap-4">
                    <div class="toast-body">
                        <img src="~/images/Frame 8.png" />
                        User Added Successfully
                    </div>
                    @* <button type="button" class=" toast-close btn-close me-2 m-auto" data-bs-dismiss="toast"
                        aria-label="Close"></button> *@
                    <img src="~/images/Close affordance.png" data-bs-dismiss="toast"
                        style="height: 24px; width: 24px;" />
                </div>
            </div>
        </div>
        <div class="user_header">
            <div class="user_dashboard_title">User Management</div>
            <div class="search-container">
                <button id="editBtn" data-bs-toggle="offcanvas" data-bs-target="#addUserSidebar"><i
                        class="ri-add-circle-line"></i>Add</button>
            </div>
        </div>


        <!-- Sidebar Offcanvas -->
        <div class="offcanvas offcanvas-end" tabindex="-1" id="addUserSidebar" aria-labelledby="addUserSidebarLabel">
            <div class="offcanvas-header p-4">
                <div class="d-flex gap-2 align-items-center">
                    <img src="~/images/Featured icon (2).png" class="sidebar_img" alt="User Icon">
                    <div class="d-flex flex-column">
                        <div class="offcanvas-title" id="addUserSidebarLabel">Add User</div>
                        <p class="m-0 offcanvas-subtitle">Enter below details to add User</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body">

                <form class="d-flex flex-column form-class">
                    <div>
                        <label class="form-label">Name</label>
                        <input type="text" class="form-control" placeholder="Enter">
                    </div>
                    <div>
                        <label class="form-label">Role</label>
                        <select class="form-select">
                            <option>Admin</option>
                            <option>Checker</option>
                            <option>Maker</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label">Sector</label>
                        <select class="form-select">
                            <option>SPB</option>
                            <option>IDCD</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label">Sub Sector</label>
                        <select class="form-select" id="subSectorSelect">
                            <option value="Industry">Industry</option>
                            <option value="Retail">Retail</option>
                            <option value="CSS">CSS</option>
                        </select>
                        <div class="tags-container" id="selectedTags"></div>
                    </div>
                    <div>
                        <label class="form-label">Email ID</label>
                        <input type="email" class="form-control" placeholder="Enter">
                    </div>
                    <div>
                        <label class="form-label">Contact</label>
                        <input type="contact" class="form-control" placeholder="Enter">
                    </div>


                </form>


            </div>
            <div class="d-flex justify-content-end p-4 user-buttons">
                <button type="button" class="btn btn-outline-dark me-2 cancel-button"
                    data-bs-dismiss="offcanvas">Cancel</button>
                <button type="button" class="btn btn-warning  add-button " data-bs-dismiss="offcanvas"
                    onclick="showToast()">Add</button>
            </div>
        </div>
        <div id="myGrid" class="ag-theme-quartz"></div>
