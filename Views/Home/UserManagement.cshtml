<link rel="stylesheet" href="~/css/user-management.css" asp-append-version="true" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="user-management">
    <div class="user-management-container">
        <div class="toast-container position-fixed bottom-0 start-50 translate-middle-x p-3">
            <div id="saveToast" class="toast custom-toast align-items-center text-white border-0" role="alert"
                aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="ri-checkbox-circle-fill"></i>
                        User Details Updated Successfully
                    </div>
                    <button type="button" class=" toast-close btn-close me-2 m-auto" data-bs-dismiss="toast"
                        aria-label="Close"></button>
                </div>
            </div>
        </div>
        <header>
            <h2 class="dashboard_title">User Management</h2>
            <div class="header-right">
                <img src="~/images/bell with badge.png" alt="notification" class="notification_image">
                <div class="user-info">
                    <img src="~/images/Ellipse 269.png" alt="user">
                    <div class="user-details">
                        <span class="username">Ranjan PM</span>
                        <small class="user-designation">Super Admin</small>
                    </div>
                    <!-- Dropdown Menu -->
                    <div class="dropdown">
                        <button class="dropdown_toggle" onclick="toggleDropdown()"><i
                                class="ri-arrow-drop-down-line"></i></button>
                        <ul class="dropdown-menu">
                            <li><a href="#">Profile</a></li>
                            <li><a href="#">Help & Settings</a></li>
                            <li><a href="#">Logout</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </header>

        <div class="search-container">
            <button id="editBtn" data-bs-toggle="offcanvas" data-bs-target="#addUserSidebar"><i
                    class="ri-add-circle-line"></i>Add</button>
        </div>
        <!-- Sidebar Offcanvas -->
        <div class="offcanvas offcanvas-end" tabindex="-1" id="addUserSidebar" aria-labelledby="addUserSidebarLabel">
            <div class="offcanvas-header p-4">
                <div class="d-flex flex-column gap-2">
                    <img src="~/images/Featured icon.png" class="rounded-circle me-2 sidebar_img" alt="User Icon">
                    <h5 class="offcanvas-title" id="addUserSidebarLabel">Add User</h5>
                    <p class="m-0">Enter below details to add User</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body">

                <form class="d-flex flex-column form-class">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" class="form-control" placeholder="Enter Name">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email ID</label>
                        <input type="email" class="form-control" placeholder="Enter Email">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Contact</label>
                        <input type="contact" class="form-control" placeholder="Enter Contact Number">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Sector</label>
                        <select class="form-select">
                            <option>Select Sector</option>
                            <option>SPB</option>
                            <option>IDCD</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Sub Sector</label>
                        <select class="form-select">
                            <option>Select Sub Sector</option>
                            <option>Industry</option>
                            <option>Retail</option>
                            <option>CSS</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Role</label>
                        <select class="form-select">
                            <option>Select Role</option>
                            <option>Admin</option>
                            <option>Checker</option>
                            <option>Maker</option>
                        </select>
                    </div>
                </form>


            </div>
            <div class="d-flex justify-content-end p-4 user-buttons">
                <button type="button" class="btn btn-outline-dark me-2 cancel-button"
                    data-bs-dismiss="offcanvas">Cancel</button>
                <button type="button" class="btn btn-warning  add-button" onclick="showToast()">Save</button>
            </div>
        </div>
        <div id="myGrid" class="ag-theme-alpine"></div>
        @section Scripts
        {
            <script src="https://cdn.jsdelivr.net/npm/ag-grid-community@30.0.0/dist/ag-grid-community.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

            <script>


                document.addEventListener("DOMContentLoaded", function () {
                    initializeGrid();

                });

                function showToast() {
                    const toastElement = document.getElementById("saveToast");
                    const toast = new bootstrap.Toast(toastElement);
                    toast.show();
                }
                function initializeGrid() {
                    console.log("came here")


                    var columnDefs = [
                        {
                            headerName: "Sector", field: "sector", editable: (params) => params.data.isEditing, cellEditor: "agSelectCellEditor", cellEditorParams: {
                                values: ["SBP", "IDCD"],
                            }, filter: "agDateColumnFilter",
                            floatingFilter: true, sortable: true, filter: true, resizable: true, cellStyle: { display: "flex", alignItems: "center", fontSize: "14px", fontWeight: 500, color: "#74828F" }
                        },
                        {
                            headerName: "Sub Sector", field: "subSector", filter: "agSetColumnFilter", // Ensure this is set for miniFilter support
                            floatingFilter: true, editable: (params) => params.data.isEditing, cellEditor: "agSelectCellEditor", cellEditorParams: {
                                values: ["Retail", "Industrial", "CSS"],
                            }, sortable: true, filter: true, resizable: true, cellStyle: { display: "flex", alignItems: "center", fontSize: "14px", fontWeight: 500, color: "#74828F" }
                        },
                        {
                            headerName: "Name",
                            field: "name",
                            sortable: true,
                            editable: (params) => params.data.isEditing,
                            filter: true,
                            resizable: true,
                            cellStyle: {
                                display: "flex",
                                alignItems: "center",
                                fontSize: "14px",
                                fontWeight: 500,
                                color: "#74828F"
                            },
                            valueSetter: function (params) {
                                params.data.name = params.newValue;
                                const nameRegex = /^[a-zA-Z0-9 ]{1,30}$/;
                                if (!newValue) {
                                    params.data.invalidName = true;
                                    params.data.nameErrorMessage = "Name cannot be empty";
                                } else if (!nameRegex.test(newValue)) {
                                    params.data.invalidName = true;
                                    params.data.nameErrorMessage = "Only alphanumeric characters allowed (max 30 characters).";
                                }
                                return true;
                            },
                            valueSetter: function (params) {
                                const newValue = params.newValue?.trim() || "";
                                let errorMessage = "";

                                // Set error message if any
                                params.data.nameError = errorMessage;

                                // Only update value if valid
                                if (!errorMessage) {
                                    params.data.name = newValue;
                                    return true;
                                }

                                return false;
                            },
                            cellRenderer: function (params) {
                                const container = document.createElement("div");
                                container.style.display = "flex";
                                container.style.alignItems = "center";
                                container.style.gap = "6px";

                                const nameText = document.createElement("span");
                                nameText.innerText = params.value || "";
                                container.appendChild(nameText);

                                if (params.data?.nameError) {
                                    const errorIcon = document.createElement("i");
                                    errorIcon.className = "ri-error-warning-line";
                                    errorIcon.style.color = "red";
                                    errorIcon.style.cursor = "pointer";
                                    errorIcon.title = errorMessage;
                                    container.appendChild(errorIcon);
                                }

                                return container;
                            }
                        }
                        ,
                        {
                            headerName: "Email",
                            field: "email",
                            editable: (params) => params.data.isEditing,
                            cellEditor: "agTextCellEditor",

                            valueSetter: function (params) {
                                params.data.email = params.newValue;
                                if (!validateEmail(params.newValue)) {
                                    params.data.invalidEmail = true;
                                    params.data.emailErrorMessage = "Invalid Email Format!";
                                } else {
                                    params.data.invalidEmail = false;
                                    params.data.emailErrorMessage = "";
                                }
                                return true;
                            },
                            cellClassRules: {
                                'email-error-cell': (params) => params.data?.invalidEmail === true
                            },
                            cellRenderer: function (params) {
                                console.log("Is Editing (inside cellRenderer):", params.data?.isEditing);

                                const container = document.createElement("div");
                                container.style.display = "flex";
                                container.style.alignItems = "center";
                                container.style.gap = "8px";


                                const emailText = document.createElement("span");
                                emailText.innerText = params.value || "";
                                container.appendChild(emailText);
                                if (params.data?.invalidEmail) {
                                    const errorIcon = document.createElement("i");
                                    errorIcon.className = "ri-error-warning-line";
                                    errorIcon.style.color = "red";
                                    errorIcon.style.cursor = "pointer";
                                    errorIcon.title = params.data.emailErrorMessage;
                                    container.appendChild(errorIcon);
                                }

                                return container;
                            }
                        },
                        {
                            headerName: "Contact",
                            field: "contact",
                            editable: (params) => params.data.isEditing,
                            cellEditor: "agTextCellEditor",
                            valueSetter: function (params) {
                                params.data.contact = params.newValue;
                                return true;
                            },
                            cellRenderer: function (params) {
                                const container = document.createElement("div");
                                container.style.display = "flex";
                                container.style.alignItems = "center";
                                const nameText = document.createElement("span");
                                nameText.innerText = params.value || "";
                                container.appendChild(nameText);
                                return container;
                            }
                        }
                        ,

                        {
                            headerName: "Role", field: "role", cellEditor: "agSelectCellEditor", cellEditorParams: {
                                values: ["Admin", "Super Admin", "Maker", "Checker"],
                            }, sortable: true, editable: (params) => params.data.isEditing, filter: true, resizable: true, cellStyle: { display: "flex", alignItems: "center", fontSize: "14px", fontWeight: 500, color: "#74828F" }
                        },

                        {
                            headerName: "Action",
                            field: "action",
                            filter: true,
                            resizable: true,
                            pinned: "right",
                            sortable: false,
                            cellStyle: {
                                display: "flex",
                                alignItems: "center",
                                fontSize: "14px",
                                fontWeight: 500,
                                color: "#74828F",
                                gap: "8px",
                            },
                            cellRenderer: function (params) {
                                const container = document.createElement("div");

                                if (params.data.isEditing) {
                                    // ✅ Save Button
                                    const saveBtn = document.createElement("button");
                                    saveBtn.innerHTML = `<i class="ri-check-line"></i>`;
                                    saveBtn.className = "save-btn";
                                    saveBtn.onclick = () => {
                                        params.data.isEditing = false;
                                        params.api.stopEditing();
                                        params.api.refreshCells({ force: true });
                                    };
                                    container.appendChild(saveBtn);


                                    const cancelBtn = document.createElement("button");
                                    cancelBtn.innerHTML = `<i class="ri-close-line"></i>`;
                                    cancelBtn.className = "cancel-btn";
                                    cancelBtn.onclick = () => {
                                        console.log("Cancelling...");
                                        params.data.isEditing = false;
                                        params.api.stopEditing(true);

                                        params.api.refreshCells({ force: true });
                                    };
                                    container.appendChild(cancelBtn);
                                } else {
                                    const editBtn = document.createElement("button");
                                    editBtn.innerHTML = `<i class="ri-pencil-line"></i> <span style="text-decoration: underline;">Edit</span>`;
                                    editBtn.className = "edit-btn";
                                    editBtn.onclick = () => {
                                        params.data.isEditing = true;
                                        params.api.refreshCells({ force: true });
                                        params.api.startEditingCell({
                                            rowIndex: params.rowIndex,
                                            colKey: "name"
                                        });
                                    };
                                    container.appendChild(editBtn);
                                }

                                return container;
                            }
                        }

                    ]

                    var rowData = [
                        { name: "Ayesha Ray", email: "Ayesharay@kbl.com", contact: "+91 9876543210", role: "Maker", function: "Retail", sector: "SBP", subSector: "Retail" },
                        { name: "Rohit Nair", email: "Rohitnair@kbl.com", contact: "+91 9876543211", role: "Checker", function: "Industry", sector: "SBP", subSector: "Industry" },
                        { name: "Pratik Joshi", email: "PJoshi@kbl.com", contact: "+91 9876543212", role: "Admin", function: "CSS", sector: "SBP", subSector: "CSS" },
                        { name: "Ayesha Ray", email: "Ayesharay@kbl.com", contact: "+91 9876543210", role: "Maker", function: "Retail", sector: "SBP", subSector: "Industry" },
                        { name: "Rohit Nair", email: "Rohitnair@kbl.com", contact: "+91 9876543211", role: "Checker", function: "Industry", sector: "SBP", subSector: "CSS" },


                    ];
                    var gridOptions = {
                        columnDefs: columnDefs,
                        rowData: rowData,
                        pagination: true,
                        paginationPageSize: 20,
                        domLayout: 'autoHeight',
                        editType: "fullRow",
                        rowHeight: 40,
                        onGridReady: function (params) {
                            params.api.sizeColumnsToFit();
                        },
                        onPaginationChanged: function () {
                            updatePaginationText();
                        },
                        onCellEditingStopped: (event) => {
                            event.data.isEditing = false;
                            event.api.refreshCells({ force: true });
                            const colId = event.column.getColId();
                            if (["name", "contact", "location", "email"].includes(colId)) {
                                console.log(`Focus OUT (editing stopped) on column: ${colId}`);
                            }
                        },
                        onCellFocused: (event) => {
                            if (event.column) {
                                const colId = event.column.getColId();
                                if (["name", "contact", "email"].includes(colId)) {
                                    console.log(`Focus IN on column: ${colId}`);
                                }
                            }
                        }
                    };
                    var gridDiv = document.querySelector("#myGrid");
                    new agGrid.Grid(gridDiv, gridOptions);

                    function updatePaginationText() {
                        setTimeout(() => {
                            const pageInfo = document.querySelector(".ag-paging-panel");
                            if (pageInfo) {
                                const currentPageSize = gridOptions.api.paginationGetPageSize();
                                const currentPageIndex = gridOptions.api.paginationGetCurrentPage();
                                const totalRows = gridOptions.api.paginationGetRowCount();
                                const startRow = currentPageIndex * currentPageSize + 1;
                                let endRow = (currentPageIndex + 1) * currentPageSize;
                                if (endRow > totalRows) endRow = totalRows;
                                const rowsThisPage = endRow - startRow + 1;
                                const customText = `Showing ${rowsThisPage} data of ${totalRows} entries`;

                                let customPaginationDiv = document.querySelector("#custom-pagination");
                                if (!customPaginationDiv) {
                                    customPaginationDiv = document.createElement("div");
                                    customPaginationDiv.id = "custom-pagination";
                                    customPaginationDiv.style.marginRight = "auto"; // Align to the left
                                    pageInfo.prepend(customPaginationDiv);
                                }
                                customPaginationDiv.innerText = customText;
                            }
                        }, 100);
                    }
                }

                function validateEmail(email) {
                    const emailRegex = /^[^\s@@]+@@[^\=s@@]+\.[^\s@@]+$/;
                    return emailRegex.test(email);
                }

                const dropzone = document.getElementById("dropzone");
                const fileInput = document.getElementById("fileInput");
                const uploadedImage = document.getElementById("uploadedImage");

                dropzone.addEventListener("click", () => {
                    fileInput.value = "";
                    fileInput.click();
                });
                fileInput.addEventListener("change", (event) => {
                    if (event.target.files.length > 0) {
                        handleFileUpload(event.target.files[0]);
                    }
                });
                dropzone.addEventListener("dragover", (event) => {
                    event.preventDefault();
                    dropzone.classList.add("border-primary");
                });

                dropzone.addEventListener("dragleave", () => {
                    dropzone.classList.remove("border-primary");
                });

                dropzone.addEventListener("drop", (event) => {
                    event.preventDefault();
                    dropzone.classList.remove("border-primary");

                    if (event.dataTransfer.files.length > 0) {
                        handleFileUpload(event.dataTransfer.files[0]);
                    }
                });

                function handleFileUpload(file) {
                    if (file && (file.type === "image/png" || file.type === "image/jpeg")) {
                        const reader = new FileReader();
                        reader.onload = function (e) {
                            uploadedImage.src = e.target.result;
                        };
                        reader.readAsDataURL(file);

                        fileInput.value = "";
                    } else {
                        alert("Only PNG and JPG images are allowed!");
                    }
                }


            </script>


        }

    </div>
</div>