<link rel="stylesheet" href="~/css/master-data.css" asp-append-version="true" />


<div id="zoneGrid" class="ag-theme-alpine">
    <div class="offcanvas offcanvas-end" tabindex="-1" id="addUserSidebar1" aria-labelledby="addUserSidebarLabel">
        <div class="offcanvas-header p-4">
            <div class="d-flex flex-column gap-2">
                <img src="~/images/Featured icon.png" class="rounded-circle me-2 sidebar_img" alt="User Icon">
                <h5 class="offcanvas-title" id="addUserSidebarLabel">Add Zone</h5>
                <p class="m-0">Add multiple Zones</p>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <div class="d-flex justify-content-between items-center">
                <div class="zone-title">Zone</div>
                <button id="addFieldBtn">Add</button>
            </div>
            <form class="d-flex flex-column form-class" id="zoneForm">
                <div id="dynamicFieldsContainer"></div>
            </form>


        </div>
        <div class="d-flex justify-content-end p-4 user-buttons">
            <button type="button" class="btn btn-outline-dark me-2 cancel-button"
                data-bs-dismiss="offcanvas">Cancel</button>
            <button type="button" class="btn btn-warning  add-button" onclick="showToast()">Save</button>
        </div>
    </div>
</div>
<script>
    window.addEventListener('DOMContentLoaded', function () {
        const columnDefs = [
            {
                headerName: "Zone Name", field: "zoneName", cellEditor: "agTextCellEditor", filter: "agSetColumnFilter", // Ensure this is set for miniFilter support
                floatingFilter: true, sortable: true, filter: true, resizable: true, editable: true, cellStyle: { display: "flex", alignItems: "center", fontSize: "14px", fontWeight: 500, color: "#74828F" }
            },
            {
                headerName: "Zone Code", field: "zoneCode", cellEditor: "agTextCellEditor", filter: "agSetColumnFilter", // Ensure this is set for miniFilter support
                floatingFilter: true, sortable: true, filter: true, editable: true, resizable: true, cellStyle: { display: "flex", alignItems: "center", fontSize: "14px", fontWeight: 500, color: "#74828F" }
            },
            {
                headerName: "Action",
                field: "action",
                filter: true,
                resizable: true,
                sortable: false,
                cellStyle: {
                    display: "flex",
                    alignItems: "center",
                    fontSize: "14px",
                    fontWeight: 500,
                    color: "#74828F",
                    gap: "8px",
                },
                cellRenderer: function (params) {
                    const container = document.createElement("div");

                    if (params.data.isEditing) {
                        const saveBtn = document.createElement("button");
                        saveBtn.innerHTML = `<i class="ri-check-line"></i>`;
                        saveBtn.className = "save-btn";
                        saveBtn.onclick = () => {
                            params.data.isEditing = false;
                            params.api.stopEditing();
                            params.api.refreshCells({ force: true });
                        };
                        container.appendChild(saveBtn);


                        const cancelBtn = document.createElement("button");
                        cancelBtn.innerHTML = `<i class="ri-close-line"></i>`;
                        cancelBtn.className = "cancel-btn";
                        cancelBtn.onclick = () => {
                            console.log("Cancelling...");
                            params.data.isEditing = false;
                            params.api.stopEditing(true);

                            params.api.refreshCells({ force: true });
                        };
                        container.appendChild(cancelBtn);
                    } else {
                        const editBtn = document.createElement("button");
                        editBtn.innerHTML = `<i class="ri-pencil-line"></i> <span style="text-decoration: underline;">Edit</span>`;
                        editBtn.className = "edit-btn";
                        editBtn.onclick = () => {
                            params.data.isEditing = true;
                            params.api.refreshCells({ force: true });
                            params.api.startEditingCell({
                                rowIndex: params.rowIndex,
                                colKey: "zoneName"
                            });
                        };
                        container.appendChild(editBtn);
                    }

                    return container;
                }
            }

        ];

        const rowData = [
            { zoneName: "East", zoneCode: "EZ" },
            { zoneName: "West", zoneCode: "WZ" },
            { zoneName: "South", zoneCode: "SZ" },
            { zoneName: "North", zoneCode: "NZ" },
            { zoneName: "Central", zoneCode: "CZ" },
            { zoneName: "West", zoneCode: "WZ" },
            { zoneName: "South", zoneCode: "SZ" },
            { zoneName: "Central", zoneCode: "CZ" },
            { zoneName: "Central", zoneCode: "CZ" },
            { zoneName: "Central", zoneCode: "CZ" },
        ];

        const gridOptions = {
            columnDefs,
            rowData,
            pagination: true,
            paginationPageSize: 40,
            domLayout: 'autoHeight',
            editType: "fullRow",
            rowHeight: 40,
            onGridReady: function (params) {
                params.api.sizeColumnsToFit();
            },
        };
        var gridDiv = document.querySelector("#zoneGrid");
        new agGrid.Grid(gridDiv, gridOptions);

        let fieldCount = 0;

        document.getElementById('addFieldBtn').addEventListener('click', () => {
            fieldCount++;

            const container = document.createElement('div');
            container.classList.add('field-group', 'mb-4');

            container.innerHTML = `
            <div class="d-flex gap-2 align-items-center ">
            <div class="mb-3">
                <input type="text" class="form-control" name="zoneName${fieldCount}" placeholder="Enter Zone Name">
                
            </div>
            <div class="mb-3">
                <input type="email" class="form-control" name="zoneEmail${fieldCount}" placeholder="Enter Zone Code">
            </div>
            <i class="ri-delete-bin-line remove-btn"></i>
            </div>
        `;

            document.getElementById('dynamicFieldsContainer').appendChild(container);
            container.querySelector('.remove-btn').addEventListener('click', () => {
                container.remove();
            });
        });
    });
</script>