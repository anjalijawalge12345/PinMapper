<link rel="stylesheet" href="~/css/master-data.css" asp-append-version="true" />


<div id="zoneGrid" class="ag-theme-quartz">
    <div class="toast-container position-fixed bottom-0 start-50 translate-middle-x p-3">
        <div id="saveToast" class="toast custom-toast align-items-center text-white border-0" role="alert"
            aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="ri-checkbox-circle-fill"></i>
                    <div> User Details Updated Successfully</div>
                </div>
                <button type="button" class=" toast-close me-2 m-auto toast_close" data-bs-dismiss="toast"
                    aria-label="Close"></button>
            </div>
        </div>
    </div>
    <div class="offcanvas offcanvas-end" tabindex="-1" id="addUserSidebar1" aria-labelledby="addUserSidebarLabel">
        <div class="offcanvas-header p-4">
            <div class="d-flex gap-2">
                <img src="~/images/zoneicon.png" class="rounded-circle me-2 sidebar_img" alt="User Icon">
                <div class="d-flex flex-column">
                    <h5 class="offcanvas-title" id="addUserSidebarLabel">Add Zone</h5>
                    <p class="m-0">Add multiple Zones</p>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <div class="d-flex justify-content-between items-center">
                <div class="d-flex  gap-2 items-center">
                    <div class="zone-title">Zone</div>
                    <div id="errorMessage" class="text-danger mb-3" style="display: none;"></div>
                </div>
                <button id="addFieldBtn" class="add-level-button">Add</button>
            </div>
            <form class="d-flex flex-column form-class" id="zoneForm">
                <div id="dynamicFieldsContainer"></div>
            </form>


        </div>
        <div class="d-flex justify-content-end p-4 user-buttons">
            <button type="button" class="btn btn-outline-dark me-2 cancel-button"
                data-bs-dismiss="offcanvas">Cancel</button>
            <button type="button" class="btn btn-warning  add-button" data-bs-dismiss="offcanvas"
                id="zoneSidebarSaveButton" onclick="showToast()">Add</button>
        </div>
    </div>
</div>
<script>
    function showToast() {
        const toastElement = document.getElementById("saveToast");
        const toast = new bootstrap.Toast(toastElement);
        toast.show();
    }
    window.addEventListener('DOMContentLoaded', function () {

        const columnDefs = [
            {
                headerName: "Zone Name", field: "zoneName", cellEditor: "agTextCellEditor", filter: true, suppressHeaderMenuButton: true,
                floatingFilter: true, sortable: true, resizable: true, editable: true, cellStyle: { display: "flex", alignItems: "center", fontSize: "14px", fontWeight: 500, color: "#74828F" }
            },
            {
                headerName: "Zone Code", field: "zoneCode", cellEditor: "agTextCellEditor", filter: "agNumberColumnFilter",
                floatingFilter: true, sortable: true, editable: true, resizable: true, cellStyle: { display: "flex", alignItems: "center", fontSize: "14px", fontWeight: 500, color: "#74828F" }
            },
            {
                headerName: "Action",
                field: "action",
                filter: true,
                resizable: true,
                sortable: false,
                cellStyle: {
                    display: "flex",
                    alignItems: "center",
                    fontSize: "14px",
                    fontWeight: 500,
                    color: "#74828F",
                    gap: "8px",
                },
                cellRenderer: function (params) {
                    const container = document.createElement("div");

                    if (params.data.isEditing) {
                        const saveBtn = document.createElement("button");
                        saveBtn.innerHTML = `<i class="ri-check-line"></i>`;
                        saveBtn.className = "save-btn";
                        saveBtn.onclick = () => {
                            params.data.isEditing = false;
                            params.api.stopEditing();
                            params.api.refreshCells({ force: true });
                        };
                        container.appendChild(saveBtn);


                        const cancelBtn = document.createElement("button");
                        cancelBtn.innerHTML = `<i class="ri-close-line"></i>`;
                        cancelBtn.className = "cancel-btn";
                        cancelBtn.onclick = () => {
                            console.log("Cancelling...");
                            params.data.isEditing = false;
                            params.api.stopEditing(true);

                            params.api.refreshCells({ force: true });
                        };
                        container.appendChild(cancelBtn);
                    } else {
                        const editBtn = document.createElement("button");
                        editBtn.innerHTML = `<i class="ri-pencil-line"></i> <span style="text-decoration: underline;">Edit</span>`;
                        editBtn.className = "edit-btn";
                        editBtn.onclick = () => {
                            params.data.isEditing = true;
                            params.api.refreshCells({ force: true });
                            params.api.startEditingCell({
                                rowIndex: params.rowIndex,
                                colKey: "zoneName"
                            });
                        };
                        container.appendChild(editBtn);
                    }

                    return container;
                }
            }

        ];

        const rowData = [
            { zoneName: "East", zoneCode: "EZ" },
            { zoneName: "West", zoneCode: "WZ" },
            { zoneName: "South", zoneCode: "SZ" },
            { zoneName: "North", zoneCode: "NZ" },
            { zoneName: "Central", zoneCode: "CZ" },
            { zoneName: "West", zoneCode: "WZ" },
            { zoneName: "South", zoneCode: "SZ" },
            { zoneName: "Central", zoneCode: "CZ" },
            { zoneName: "Central", zoneCode: "CZ" },
            { zoneName: "Central", zoneCode: "CZ" },
        ];

        const gridOptions = {
            columnDefs,
            rowData,
            pagination: true,
            paginationPageSize: 40,
            domLayout: 'autoHeight',
            editType: "fullRow",
            defaultColDef: {
                flex: 1,
                minWidth: 150,
                filter: true,
                floatingFilter: true,
                suppressHeaderMenuButton: true,
            },
            rowHeight: 40,
            onGridReady: function (params) {
                params.api.sizeColumnsToFit();
            },
        };
        var gridDiv = document.querySelector("#zoneGrid");
        new agGrid.Grid(gridDiv, gridOptions);

        let fieldCount = 0;

        const zoneSidebarSaveButton = document.getElementById('zoneSidebarSaveButton');
        @* if (fieldCount == 0) { zoneSidebarSaveButton.disabled = true; } *@
            zoneSidebarSaveButton.disabled = true;
        const validateFields = () => {
            const allInputs = document.querySelectorAll('#dynamicFieldsContainer input');
            let allFilled = true;
            allInputs.forEach(input => {
                if (!input.value.trim()) {
                    allFilled = false;
                }
            });

            // Enable Save button only if all inputs are filled and at least one field exists
            zoneSidebarSaveButton.disabled = !(fieldCount > 0 && allFilled);
        };
        document.getElementById('addFieldBtn').addEventListener('click', () => {
            const errorDiv = document.getElementById('errorMessage');
            const addButton = document.getElementById('addFieldBtn');
            console.log(fieldCount)
            if (fieldCount >= 10) {
                addButton.disabled = true;
                errorDiv.innerText = "You cannot add more than 10 zones.";
                errorDiv.style.display = "block";
                return;
            }

            // Clear error if previously shown
            errorDiv.innerText = "";
            errorDiv.style.display = "none";
            fieldCount++;

            const container = document.createElement('div');
            container.classList.add('field-group', 'mb-4');

            container.innerHTML = `
            <div class="d-flex gap-2 align-items-center ">
            <div class="mb-3">
                <input type="text" class="form-control" name="zoneName${fieldCount}" placeholder="Enter Zone Name">
                
            </div>
            <div class="mb-3">
                <input type="email" class="form-control" name="zoneEmail${fieldCount}" placeholder="Enter Zone Code">
            </div>
            <i class="ri-delete-bin-line remove-btn"></i>
            </div>
        `;

            document.getElementById('dynamicFieldsContainer').appendChild(container);
            if (fieldCount > 0) {
                zoneSidebarSaveButton.disabled = false;
            }
            const inputs = container.querySelectorAll('input');
            inputs.forEach(input => {
                input.addEventListener('input', validateFields);
            });

            // Trigger initial validation
            validateFields();
            container.querySelector('.remove-btn').addEventListener('click', () => {
                container.remove();
                fieldCount--;
                console.log("remove", fieldCount)
                if (fieldCount < 10) {
                    addButton.disabled = false;
                    errorDiv.style.display = "none";
                }

                // Disable Save button if no fields exist
                if (fieldCount === 0) {
                    zoneSidebarSaveButton.disabled = true;
                }
                validateFields();
            });
        });
    });
</script>